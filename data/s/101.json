{"n":101,"ayahs":[{"w":[["ٱلْقَارِعَةُ","The Striking Calamity","al-qāriʿatu","",[["ٱلْ",3,3,"p"],["قَارِعَةُ",90,2744,""]],2744]],"ur":"کھڑ کھڑانے والی","ur2":"وہ کھڑکھڑا ڈالنے والی","en":"The Calamity"},{"w":[["مَا","What","mā","",[["مَا",140,38,""]],38],["ٱلْقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu","",[["ٱلْ",3,3,"p"],["قَارِعَةُ",90,2744,""]],2744]],"ur":"کھڑ کھڑانے والی کیا ہے؟","ur2":"کیا ہے وہ کھڑ کھڑا ڈالنے والی","en":"What is the Calamity"},{"w":[["وَمَآ","And what","wamā","",[["وَ",10,15,"p"],["مَآ",140,38,""]],38],["أَدْرَىٰكَ","will make you know","adrāka","",[["أَدْرَىٰ",80,2445,""],["كَ",18,-1,"s"]],2445],["مَا","what","mā","",[["مَا",140,38,""]],38],["ٱلْقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu","",[["ٱلْ",3,3,"p"],["قَارِعَةُ",90,2744,""]],2744]],"ur":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟","ur2":"اور تو کیا سمجھا کیا ہے وہ کھڑ کھڑا ڈالنے والی","en":"Ah, what will convey unto thee what the Calamity is"},{"w":[["يَوْمَ","(The) Day","yawma","",[["يَوْمَ",271,11,""]],11],["يَكُونُ","will be","yakūnu","",[["يَكُونُ",441,75,""]],75],["ٱلنَّاسُ","the mankind","l-nāsu","",[["ٱل",3,3,"p"],["نَّاسُ",81,61,""]],61],["كَٱلْفَرَاشِ","like moths","kal-farāshi","",[["كَ",0,84,"p"],["ٱلْ",3,3,"p"],["فَرَاشِ",1,4745,""]],4745],["ٱلْمَبْثُوثِ","scattered","l-mabthūthi","",[["ٱلْ",3,3,"p"],["مَبْثُوثِ",1015,4746,""]],4746]],"ur":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے","ur2":"جس دن ہوویں لوگ جیسے پتنگے بکھرے ہوئے","en":"A day wherein mankind will be as thickly-scattered moths"},{"w":[["وَتَكُونُ","And will be","watakūnu","",[["وَ",10,15,"p"],["تَكُونُ",672,75,""]],75],["ٱلْجِبَالُ","the mountains","l-jibālu","",[["ٱلْ",3,3,"p"],["جِبَالُ",81,1045,""]],1045],["كَٱلْعِهْنِ","like wool","kal-ʿih'ni","",[["كَ",0,84,"p"],["ٱلْ",3,3,"p"],["عِهْنِ",1,4425,""]],4425],["ٱلْمَنفُوشِ","fluffed up","l-manfūshi","",[["ٱلْ",3,3,"p"],["مَنفُوشِ",1015,4747,""]],4747]],"ur":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون","ur2"