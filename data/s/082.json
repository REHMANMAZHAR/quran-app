{"n":82,"ayahs":[{"w":[["إِذَا","When","idhā","",[["إِذَا",67,77,""]],77],["ٱلسَّمَآءُ","the sky","l-samāu","",[["ٱل",3,3,"p"],["سَّمَآءُ",90,119,""]],119],["ٱنفَطَرَتْ","(is) cleft asunder","infaṭarat","",[["ٱنفَطَرَتْ",215,4619,""]],4619]],"ur":"جب آسمان پھٹ جائے گا","ur2":"جب آسمان چِر جائے","en":"When the heaven is cleft asunder"},{"w":[["وَإِذَا","And when","wa-idhā","",[["وَ",10,15,"p"],["إِذَا",67,77,""]],77],["ٱلْكَوَاكِبُ","the stars","l-kawākibu","",[["ٱلْ",3,3,"p"],["كَوَاكِبُ",81,1908,""]],1908],["ٱنتَثَرَتْ","scatter","intatharat","",[["ٱنتَثَرَتْ",414,4620,""]],4620]],"ur":"اور جب تارے جھڑ پڑیں گے","ur2":"اور جب تارے جھڑ پڑیں","en":"When the planets are dispersed"},{"w":[["وَإِذَا","And when","wa-idhā","",[["وَ",10,15,"p"],["إِذَا",67,77,""]],77],["ٱلْبِحَارُ","the seas","l-biḥāru","",[["ٱلْ",3,3,"p"],["بِحَارُ",81,302,""]],302],["فُجِّرَتْ","are made to gush forth","fujjirat","",[["فُجِّرَتْ",487,2993,""]],2993]],"ur":"اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے","ur2":"اور جب دریا ابل نکلیں","en":"When the seas are poured forth"},{"w":[["وَإِذَا","And when","wa-idhā","",[["وَ",10,15,"p"],["إِذَا",67,77,""]],77],["ٱلْقُبُورُ","the graves","l-qubūru","",[["ٱلْ",3,3,"p"],["قُبُورُ",81,2380,""]],2380],["بُعْثِرَتْ","are overturned","buʿ'thirat","",[["بُعْثِرَتْ",223,4621,""]],4621]],"ur":"اور جب قبریں اکھیڑ دی جائیں گی","ur2":"اور جب قبریں زیروزبر کر دی جائیں","en":"And the sepulchres are overturned"},{"w":[["عَلِمَتْ","Will know","ʿalimat","",[["عَلِمَتْ",89,87,""]],87],["نَفْسٌ","a soul","nafsun","",[["نَفْسٌ",193,69,""]],69],["مَّا","what","mā","",[["مَّا",35,38,""]],38],["قَدَّمَتْ","it has sent forth","qaddamat","",[["قَدَّمَتْ",289,503,""]],503],["وَأَخَّرَتْ","and left behind","wa-akharat","",[["وَ",10,15,"p"],["أَخَّرَتْ",289,1580,""]],1580]],"ur":"تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا","ur2":"جان لے ہر ایک جی جو کچھ کہ آگے بھیجا اور پیچھے چھوڑا","en":"A soul will know what it hath sent before (it) and what left behind"},{"w":[["يَٰٓأَيُّهَا","O","yāayyuhā","",[["يَٰٓ",107,141,"p"],["أَيُّ",108,142,""],["هَا",109,143,"s"]],142],["ٱلْإِنسَٰنُ","man","l-insānu","",[["ٱلْ",3,3,"p"],["إِنسَٰنُ",5,353,""]],353],["مَا","What","mā","",[["مَا",35,38,""]],38],["غَرَّكَ","has deceived you","gharraka","",[["غَرَّ",49,1182,""],["كَ",18,-1,"s"]],1182],["بِرَبِّكَ","concerning your Lord","birabbika","",[["بِ",0,0,"p"],["رَبِّ",1,8,""],["كَ",18,-1,"s"]],8],["ٱلْكَرِيمِ","the Most Noble","l-karīmi","",[["ٱلْ",3,3,"p"],["كَرِيمِ",4,1507,""]],1507]],"ur":"اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا","ur2":"اے آدمی کس چیز سے بہکا تو اپنے رب کریم پر","en":"O man! What hath made thee careless concerning thy Lord, the Bountiful"},{"w":[["ٱلَّذِى","Who","alladhī","",[["ٱلَّذِى",92,20,""]],20],["خَلَقَكَ","created you","khalaqaka","",[["خَلَقَ",49,144,""],["كَ",18,-1,"s"]],144],["فَسَوَّىٰكَ","then fashioned you","fasawwāka","",[["فَ",10,72,"p"],["سَوَّىٰ",146,208,""],["كَ",18,-1,"s"]],208],["فَعَدَلَكَ","then balanced you","faʿadalaka","",[["فَ",10,72,"p"],["عَدَلَ",49,1435,""],["كَ",18,-1,"s"]],1435]],"ur":"(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا","ur2":"جس نے تجھ کو بنایا پھر تجھ کو ٹھیک کیا پھر تجھ کو برابر کیا","en":"Who created thee, then fashioned, then proportioned thee"},{"w":[["فِىٓ","In","fī","",[["فِىٓ",19,30,""]],30],["أَىِّ","whatever","ayyi","",[["أَىِّ",1056,142,""]],142],["صُورَةٍ","form","ṣūratin","",[["صُورَةٍ",120,3971,""]],3971],["مَّا","what","mā","",[["مَّا",138,64,""]],64],["شَآءَ","He willed","shāa","",[["شَآءَ",49,137,""]],137],["رَكَّبَكَ","He assembled you","rakkabaka","",[["رَكَّبَ",146,4622,""],["كَ",18,-1,"s"]],4622]],"ur":"اور جس صورت میں چاہا تجھے جوڑ دیا","ur2":"جس صورت میں چاہا تجھ کو جوڑ دیا","en":"Into whatsoever form He will, He casteth thee"},{"w":[["كَلَّا","Nay","kallā","",[["كَلَّا",875,3189,""]],3189],["بَلْ","But","bal","",[["بَلْ",277,488,""]],488],["تُكَذِّبُونَ","you deny","tukadhibūna","",[["تُكَذِّبُ",252,256,""],["ونَ",71,-1,"s"]],256],["بِٱلدِّينِ","the Judgment","bil-dīni","",[["بِ",0,0,"p"],["ٱل",3,3,"p"],["دِّينِ",1,12,""]],12]],"ur":"مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو","ur2":"ہرگز نہیں پر تم جھوٹ جانتے ہو انصاف کا ہونا","en":"Nay, but ye deny the Judgment"},{"w":[["وَإِنَّ","And indeed","wa-inna","",[["وَ",34,15,"p"],["إِنَّ",44,47,""]],47],["عَلَيْكُمْ","over you","ʿalaykum","",[["عَلَيْ",19,22,""],["كُمْ",71,-1,"s"]],22],["لَحَٰفِظِينَ","(are) surely guardians","laḥāfiẓīna","",[["لَ",106,7,"p"],["حَٰفِظِينَ",121,2415,""]],2415]],"ur":"حالانکہ تم پر نگہبان مقرر ہیں","ur2":"اور تم پر نگہبان مقرر ہیں","en":"Lo! there are above you guardians"},{"w":[["كِرَامًا","Noble","kirāman","",[["كِرَامًا",719,1507,""]],1507],["كَٰتِبِينَ","recording","kātibīna","",[["كَٰتِبِينَ",230,1108,""]],1108]],"ur":"عالی قدر (تمہاری باتوں کے) لکھنے والے","ur2":"عزت والے عمل لکھنے والے","en":"Generous and recording"},{"w":[["يَعْلَمُونَ","They know","yaʿlamūna","",[["يَعْلَمُ",62,87,""],["ونَ",20,-1,"s"]],87],["مَا","whatever","mā","",[["مَا",35,38,""]],38],["تَفْعَلُونَ","you do","tafʿalūna","",[["تَفْعَلُ",116,164,""],["ونَ",71,-1,"s"]],164]],"ur":"جو تم کرتے ہو وہ اسے جانتے ہیں","ur2":"جانتے ہیں جو کچھ تم کرتے ہو","en":"Who know (all) that ye do"},{"w":[["إِنَّ","Indeed","inna","",[["إِنَّ",44,47,""]],47],["ٱلْأَبْرَارَ","the righteous","l-abrāra","",[["ٱلْ",3,3,"p"],["أَبْرَارَ",101,1422,""]],1422],["لَفِى","(will be) surely in","lafī","",[["لَ",106,7,"p"],["فِى",19,30,""]],30],["نَعِيمٍ","bliss","naʿīmin","",[["نَعِيمٍ",42,1785,""]],1785]],"ur":"بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔","ur2":"بیشک نیک لوگ بہشت میں ہیں","en":"Lo! the righteous verily will be in delight"},{"w":[["وَإِنَّ","And indeed","wa-inna","",[["وَ",10,15,"p"],["إِنَّ",44,47,""]],47],["ٱلْفُجَّارَ","the wicked","l-fujāra","",[["ٱلْ",3,3,"p"],["فُجَّارَ",121,3913,""]],3913],["لَفِى","(will be) surely in","lafī","",[["لَ",106,7,"p"],["فِى",19,30,""]],30],["جَحِيمٍ","Hellfi