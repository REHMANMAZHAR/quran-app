 تو اُس نے برا کیا اپنا اُسکو خبر نہیں شاید اللہ پیدا کر دے اُس طلاق کے بعد نئی صورت","en":"O Prophet! When ye (men) put away women, put them away for their (legal) period and reckon the period, and keep your duty to Allah, your Lord. Expel them not from their houses nor let them go forth unless they commit open immorality. Such are the limits (imposed by) Allah; and whoso transgresseth Allah's limits, he verily wrongeth his soul. Thou knowest not: it may be that Allah will afterward bring some new thing to pass"},{"w":[["فَإِذَا","Then when","fa-idhā","",[["فَ",34,72,"p"],["إِذَا",67,77,""]],77],["بَلَغْنَ","they have reached","balaghna","",[["بَلَغْ",417,798,""],["نَ",147,-1,"s"]],798],["أَجَلَهُنَّ","their term","ajalahunna","",[["أَجَلَ",14,925,""],["هُنَّ",147,-1,"s"]],925],["فَأَمْسِكُوهُنَّ","then retain them","fa-amsikūhunna","",[["فَ",119,72,"p"],["أَمْسِكُ",78,926,""],["و",71,-1,"s"],["هُنَّ",147,-1,"s"]],926],["بِمَعْرُوفٍ","with kindness","bimaʿrūfin","",[["بِ",0,0,"p"],["مَعْرُوفٍ",412,736,""]],736],["أَوْ","or","aw","",[["أَوْ",47,117,""]],117],["فَارِقُوهُنَّ","part with them","fāriqūhunna","",[["فَارِقُ",373,4352,""],["و",71,-1,"s"],["هُنَّ",147,-1,"s"]],4352],["بِمَعْرُوفٍ","with kindness","bimaʿrūfin","",[["بِ",0,0,"p"],["مَعْرُوفٍ",412,736,""]],736],["وَأَشْهِدُوا۟","And take witness","wa-ashhidū","",[["وَ",10,15,"p"],["أَشْهِدُ",78,832,""],["وا۟",71,-1,"s"]],832],["ذَوَىْ","two men","dhaway","",[["ذَوَىْ",456,455,""]],455],["عَدْلٍ","just","ʿadlin","",[["عَدْلٍ",42,290,""]],290],["مِّنكُمْ","among you","minkum","",[["مِّن",19,37,""],["كُمْ",71,-1,"s"]],37],["وَأَقِيمُوا۟","and establish","wa-aqīmū","",[["وَ",10,15,"p"],["أَقِيمُ",78,35,""],["وا۟",71,-1,"s"]],35],["ٱلشَّهَٰدَةَ","the testimony","l-shahādata","",[["ٱل",3,3,"p"],["شَّهَٰدَةَ",33,642,""]],642],["لِلَّهِ","for Allah","lillahi","",[["لِ",0,7,"p"],["لَّهِ",2,2,""]],2],["ذَٰلِكُمْ","That","dhālikum","",[["ذَٰ",25,27,""],["لِ",26,7,"s"],["كُمْ",201,-1,"s"]],27],["يُوعَظُ","is instructed",