{"n":1,"ayahs":[{"w":[["بِسْمِ","In (the) name","bis'mi","",[["بِ",0,0,"p"],["سْمِ",1,1,""]],1],["ٱللَّهِ","(of) Allah","l-lahi","",[["ٱللَّهِ",2,2,""]],2],["ٱلرَّحْمَٰنِ","the Most Gracious","l-raḥmāni","",[["ٱل",3,3,"p"],["رَّحْمَٰنِ",4,4,""]],4],["ٱلرَّحِيمِ","the Most Merciful","l-raḥīmi","",[["ٱل",3,3,"p"],["رَّحِيمِ",4,5,""]],5]],"ur":"شروع الله کا نام لے کر جو بڑا مہربان نہایت رحم والا ہے","ur2":"شروع اللہ کے نام سے جو بڑا مہربان نہایت رحم والا ہے","en":"In the name of Allah, the Beneficent, the Merciful"},{"w":[["ٱلْحَمْدُ","All praises and thanks","al-ḥamdu","",[["ٱلْ",3,3,"p"],["حَمْدُ",5,6,""]],6],["لِلَّهِ","(be) to Allah","lillahi","",[["لِ",0,7,"p"],["لَّهِ",2,2,""]],2],["رَبِّ","the Lord","rabbi","",[["رَبِّ",1,8,""]],8],["ٱلْعَٰلَمِينَ","of the universe","l-ʿālamīna","",[["ٱلْ",3,3,"p"],["عَٰلَمِينَ",6,9,""]],9]],"ur":"سب طرح کی تعریف خدا ہی کو (سزاوار) ہے جو تمام مخلوقات کا پروردگار ہے","ur2":"سب تعریفیں اللہ کے لئے ہیں جو پالنے والا سارے جہان کا","en":"Praise be to Allah, Lord of the Worlds"},{"w":[["ٱلرَّحْمَٰنِ","The Most Gracious","al-raḥmāni","",[["ٱل",3,3,"p"],["رَّحْمَٰنِ",4,4,""]],4],["ٱلرَّحِيمِ","the Most Merciful","l-raḥīmi","",[["ٱل",3,3,"p"],["رَّحِيمِ",4,5,""]],5]],"ur":"بڑا مہربان نہایت رحم والا","ur2":"بےحد مہربان نہایت رحم والا","en":"The Beneficent, the Merciful"},{"w":[["مَٰلِكِ","(The) Master","māliki","",[["مَٰلِكِ",7,10,""]],10],["يَوْمِ","(of the) Day","yawmi","",[["يَوْمِ",1,11,""]],11],["ٱلدِّينِ","(of the) Judgment","l-dīni","",[["ٱل",3,3,"p"],["دِّينِ",1,12,""]],12]],"ur":"انصاف کے دن کا حاکم","ur2":"مالک روز جزا کا","en":"Master of the Day of Judgment"},{"w":[["إِيَّاكَ","You Alone","iyyāka","",[["إِيَّاكَ",8,13,""]],13],["نَعْبُدُ","we worship","naʿbudu","",[["نَعْبُدُ",9,14,""]],14],["وَإِيَّاكَ","and You Alone","wa-iyyāka","",[["وَ",10,15,"p"],["إِيَّاكَ",8,13,""]],13],["نَسْتَعِينُ","we ask for help","nastaʿīnu","",[["نَسْتَعِينُ",11,16,""]],16]],"ur":"(اے پروردگار) ہم تیری ہی عبادت کرتے ہیں اور تجھ ہی سے مدد مانگتے ہیں","ur2":"تیری ہی ہم بندگی کرتے ہیں اور تجھی سے مدد چاہتے ہیں","en":"Thee (alone) we worship; Thee (alone) we ask for help"},{"w":[["ٱهْدِنَا","Guide us","ih'dinā","",[["ٱهْدِ",12,17,""],["نَا",13,-1,"s"]],17],["ٱلصِّرَٰطَ","(to) the path","l-ṣirāṭa","",[["ٱل",3,3,"p"],["صِّرَٰطَ",14,18,""]],18],["ٱلْمُسْتَقِيمَ","the straight","l-mus'taqīma","",[["ٱلْ",3,3,"p"],["مُسْتَقِيمَ",15,19,""]],19]],"ur":"ہم کو سیدھے رستے چلا","ur2":"بتلا ہم کو راہ سیدھی","en":"Show us the straight path"},{"w":[["صِرَٰطَ","(The) path","ṣirāṭa","",[["صِرَٰطَ",14,18,""]],18],["ٱلَّذِينَ","(of) those","alladhīna","",[["ٱلَّذِينَ",16,20,""]],20],["أَنْعَمْتَ","You have bestowed (Your) Favors","anʿamta","",[["أَنْعَمْ",17,21,""],["تَ",18,-1,"s"]],21],["عَلَيْهِمْ","on them","ʿalayhim","",[["عَلَيْ",19,22,""],["هِمْ",20,-1,"s"]],22],["غَيْرِ","not (of)","ghayri","",[["غَيْرِ",1,23,""]],23],["ٱلْمَغْضُوبِ","those who earned (Your) wrath","l-maghḍūbi","",[["ٱلْ",3,3,"p"],["مَغْضُوبِ",21,24,""]],24],["عَلَيْهِمْ","on themselves","ʿalayhim","",[["عَلَيْ",19,22,""],["هِمْ",20,-1,"s"]],22],["وَلَا","and not","walā","",[["وَ",10,15,"p"],["لَا",22,25,""]],25],["ٱلضَّآلِّينَ","(of) those who go astray","l-ḍālīna","",[["ٱل",3,3,"p"],["ضَّآلِّينَ",23,26,""]],26]],"ur":"ان لوگوں کے رستے جن پر تو اپنا فضل وکرم کرتا رہا نہ ان کے جن پر غصے ہوتا رہا اور نہ گمراہوں کے","ur2":"راہ ان لوگوں کی جن پر تو نے فضل فرمایا جن پر نہ تیرا غصہ ہوا اور نہ وہ گمراہ ہوئے","en":"The path of those whom Thou hast favoured; Not the (path) of those who earn Thine anger nor of those who go astray"}]}