{"n":112,"ayahs":[{"w":[["قُلْ","Say","qul","",[["قُلْ",12,63,""]],63],["هُوَ","He","huwa","",[["هُوَ",113,-1,""]],-1],["ٱللَّهُ","(is) Allah","l-lahu","",[["ٱللَّهُ",50,2,""]],2],["أَحَدٌ","the One","aḥadun","",[["أَحَدٌ",30,508,""]],508]],"ur":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","ur2":"تو کہہ وہ اللہ ایک ہے","en":"Say: He is Allah, the One"},{"w":[["ٱللَّهُ","Allah","al-lahu","",[["ٱللَّهُ",50,2,""]],2],["ٱلصَّمَدُ","the Eternal, the Absolute","l-ṣamadu","",[["ٱل",3,3,"p"],["صَّمَدُ",157,4776,""]],4776]],"ur":"معبود برحق جو بےنیاز ہے","ur2":"اللہ بے نیاز ہے","en":"Allah, the eternally Besought of all"},{"w":[["لَمْ","Not","lam","",[["لَمْ",22,53,""]],53],["يَلِدْ","He begets","yalid","",[["يَلِدْ",315,2540,""]],2540],["وَلَمْ","and not","walam","",[["وَ",10,15,"p"],["لَمْ",22,53,""]],53],["يُولَدْ","He is begotten","yūlad","",[["يُولَدْ",595,2540,""]],2540]],"ur":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","ur2":"نہ کسی کو جنا نہ کسی سے جنا","en":"He begetteth not nor was begotten"},{"w":[["وَلَمْ","And not","walam","",[["وَ",10,15,"p"],["لَمْ",22,53,""]],53],["يَكُن","is","yakun","",[["يَكُن",378,75,""]],75],["لَّهُۥ","for Him","lahu","",[["لَّ",0,7,"p"],["هُۥ",113,-1,""]],-1],["كُفُوًا","equivalent","kufuwan","",[["كُفُوًا",65,4777,""]],4777],["أَحَدٌۢ","any [one]","aḥadun","",[["أَحَدٌۢ",30,508,""]],508]],"ur":"اور کوئی اس کا ہمسر نہیں","ur2":"اور نہیں اُس کے جوڑ کا کوئی","en":"And there is none comparable unto Him"}]}