{"n":107,"ayahs":[{"w":[["أَرَءَيْتَ","Have you seen","ara-ayta","",[["أَ",82,85,"p"],["رَءَيْ",244,324,""],["تَ",18,-1,"s"]],324],["ٱلَّذِى","the one who","alladhī","",[["ٱلَّذِى",92,20,""]],20],["يُكَذِّبُ","denies","yukadhibu","",[["يُكَذِّبُ",310,256,""]],256],["بِٱلدِّينِ","the Judgment","bil-dīni","",[["بِ",0,0,"p"],["ٱل",3,3,"p"],["دِّينِ",1,12,""]],12]],"ur":"بھلا تم نے اس شخص کو دیکھا جو (روزِ) جزا کو جھٹلاتا ہے؟","ur2":"تو نے دیکھا اُسکو جو جھٹلاتا ہے انصاف ہونے کو","en":"Hast thou observed him who belieth religion"},{"w":[["فَذَٰلِكَ","Then that","fadhālika","",[["فَ",10,72,"p"],["ذَٰ",25,27,""],["لِ",26,7,"s"],["كَ",27,-1,"s"]],27],["ٱلَّذِى","(is) the one who","alladhī","",[["ٱلَّذِى",92,20,""]],20],["يَدُعُّ","repulses","yaduʿʿu","",[["يَدُعُّ",54,4154,""]],4154],["ٱلْيَتِيمَ","the orphan","l-yatīma","",[["ٱلْ",3,3,"p"],["يَتِيمَ",189,457,""]],457]],"ur":"یہ وہی (بدبخت) ہے، جو یتیم کو دھکے دیتا ہے","ur2":"سو یہ وہی ہے جو دھکے دیتا ہے یتیم کو","en":"That is he who repelleth the orphan"},{"w":[["وَلَا","And (does) not","walā","",[["وَ",10,15,"p"],["لَا",22,25,""]],25],["يَحُضُّ","feel the urge","yaḥuḍḍu","",[["يَحُضُّ",54,4421,""]],4421],["عَلَىٰ","to","ʿalā","",[["عَلَىٰ",19,22,""]],22],["طَعَامِ","feed","ṭaʿāmi","",[["طَعَامِ",1,358,""]],358],["ٱلْمِسْكِينِ","the poor","l-mis'kīni","",[["ٱلْ",3,3,"p"],["مِسْكِينِ",263,458,""]],458]],"ur":"اور فقیر کو کھانا کھلانے کے لیے (لوگوں کو) ترغیب نہیں دیتا","ur2":"اور نہیں تاکید کرتا محتاج کے کھانے پر","en":"And urgeth not the feeding of the needy"},{"w":[["فَوَيْلٌ","So woe","fawaylun","",[["فَ",34,72,"p"],["وَيْلٌ",30,444,""]],444],["لِّلْمُصَلِّينَ","to those who pray","lil'muṣallīna","",[["لِّ",0,7,"p"],["لْ",3,3,"p"],["مُصَلِّينَ",533,4436,""]],4436]],"ur":"تو ایسے نمازیوں کی خرابی ہے","ur2":"پھر خرابی ہے اُن نمازیوں کی","en":"Ah, woe unto worshippers"},{"w":[["ٱلَّذِينَ","Those who","alladhīna","",[["ٱلَّذِينَ",16,20,""]],20],["هُمْ","[they]","hum","",[["هُمْ",40,-1,""]],-1],["عَن","about","ʿan","",[["عَن",19,240,""]],240],["صَلَاتِهِمْ","their prayers","ṣalātihim","",[["صَلَاتِ",72,36,""],["هِمْ",20,-1,"s"]],36],["سَاهُونَ","(are) neglectful","sāhūna","",[["سَاهُونَ",136,4137,""]],4137]],"ur":"جو نماز کی طرف سے غافل رہتے ہیں","ur2":"جو اپنی نماز سے بے خبر ہیں","en":"Who are heedless of their prayer"},{"w":[["ٱلَّذِينَ","Those who","alladhīna","",[["ٱلَّذِينَ",16,20,""]],20],["هُمْ","[they]","hum","",[["هُمْ",40,-1,""]],-1],["يُرَآءُونَ","make show","yurāūna","",[["يُرَآءُ",59,1662,""],["ونَ",20,-1,"s"]],1662]],"ur":"جو ریا کاری کرتے ہیں","ur2":"وہ جو دکھلاوا کرتے ہیں","en":"Who would be seen (at worship)"},{"w":[["وَيَمْنَعُونَ","And they deny","wayamnaʿūna","",[["وَ",10,15,"p"],["يَمْنَعُ",62,566,""],["ونَ",20,-1,"s"]],566],["ٱلْمَاعُونَ","[the] small kindnesses","l-māʿūna","",[["ٱلْ",3,3,"p"],["مَاعُونَ",14,4767,""]],4767]],"ur":"اور برتنے کی چیزیں عاریتہً نہیں دیتے","ur2":"اور مانگے نہ دیویں برتنے کی چیز","en":"Yet refuse small kindnesses"}]}