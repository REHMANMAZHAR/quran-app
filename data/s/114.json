{"n":114,"ayahs":[{"w":[["قُلْ","Say","qul","کہہ دیجئے",[["قُلْ",12,63,""]],63],["أَعُوذُ","I seek refuge","aʿūdhu","میں پناہ چاہتا ہوں",[["أَعُوذُ",153,400,""]],400],["بِرَبِّ","in (the) Lord","birabbi","رب کی",[["بِ",0,0,"p"],["رَبِّ",1,8,""]],8],["ٱلنَّاسِ","(of) mankind","l-nāsi","انسانوں کے",[["ٱل",3,3,"p"],["نَّاسِ",6,61,""]],61]],"ur":"کہو کہ میں لوگوں کے پروردگار کی پناہ مانگتا ہوں","ur2":"تو کہہ میں پناہ میں آیا لوگوں کے رب کی","en":"Say: I seek refuge in the Lord of mankind","en2":"Say: I seek refuge with the Lord and Cherisher of Mankind"},{"w":[["مَلِكِ","(The) King","maliki","بادشاہ",[["مَلِكِ",263,977,""]],977],["ٱلنَّاسِ","(of) mankind","l-nāsi","انسانوں کے",[["ٱل",3,3,"p"],["نَّاسِ",6,61,""]],61]],"ur":"(یعنی) لوگوں کے حقیقی بادشاہ کی","ur2":"لوگوں کے بادشاہ کی","en":"The King of mankind","en2":"The King (or Ruler) of Mankind"},{"w":[["إِلَٰهِ","(The) God","ilāhi","الٰہ کی/معبود کی",[["إِلَٰهِ",263,629,""]],629],["ٱلنَّاسِ","(of) mankind","l-nāsi","انسانوں کے",[["ٱل",3,3,"p"],["نَّاسِ",6,61,""]],61]],"ur":"لوگوں کے معبود برحق کی","ur2":"لوگوں کے معبود کی","en":"The god of mankind","en2":"The god (or judge) of Mankind"},{"w":[["مِن","From","min","سے",[["مِن",19,37,""]],37],["شَرِّ","(the) evil","sharri","شر",[["شَرِّ",263,864,""]],864],["ٱلْوَسْوَاسِ","(of) the whisperer","l-waswāsi","وسوسہ ڈالنے والے",[["ٱلْ",3,3,"p"],["وَسْوَاسِ",263,4774,""]],4774],["ٱلْخَنَّاسِ","the one who withdraws","l-khanāsi","بار بار پلٹ کر آنے والے کے",[["ٱلْ",3,3,"p"],["خَنَّاسِ",4,4775,""]],4775]],"ur":"(شیطان) وسوسہ انداز کی برائی سے جو (خدا کا نام سن کر) پیچھے ہٹ جاتا ہے","ur2":"بدی سے اُسکی جو پھسلائے اور چھپ جائے","en":"From the evil of the sneaking whisperer","en2":"From the mischief of the Whisperer (of Evil), who withdraws (after his whisper)"},{"w":[["ٱلَّذِى","The one who","alladhī","وہ جو",[["ٱلَّذِى",92,20,""]],20],["يُوَسْوِسُ","whispers","yuwaswisu","وسوسہ ڈالتا ہے",[["يُوَسْوِسُ",54,2044,""]],2044],["فِى","in","fī","میں",[["فِى",19,30,""]],30],["صُدُورِ","(t