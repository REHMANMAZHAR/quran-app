{"n":111,"ayahs":[{"w":[["تَبَّتْ","Perish","tabbat","",[["تَبَّتْ",89,4772,""]],4772],["يَدَآ","(the) hands","yadā","",[["يَدَآ",216,394,""]],394],["أَبِى","(of) Abu","abī","",[["أَبِى",263,1902,""]],1902],["لَهَبٍ","Lahab","lahabin","",[["لَهَبٍ",42,4548,""]],4548],["وَتَبَّ","and perish he","watabba","",[["وَ",10,15,"p"],["تَبَّ",49,4772,""]],4772]],"ur":"ابولہب کے ہاتھ ٹوٹیں اور وہ ہلاک ہو","ur2":"ٹوٹ گئے ہاتھ ابی لہب کے اور ٹوٹ گیا وہ آپ","en":"The power of Abu Lahab will perish, and he will perish"},{"w":[["مَآ","Not","mā","",[["مَآ",22,64,""]],64],["أَغْنَىٰ","(will) avail","aghnā","",[["أَغْنَىٰ",49,2080,""]],2080],["عَنْهُ","him","ʿanhu","",[["عَنْ",19,240,""],["هُ",29,-1,"s"]],240],["مَالُهُۥ","his wealth","māluhu","",[["مَالُ",5,666,""],["هُۥ",29,-1,"s"]],666],["وَمَا","and what","wamā","",[["وَ",10,15,"p"],["مَا",35,38,""]],38],["كَسَبَ","he earned","kasaba","",[["كَسَبَ",49,446,""]],446]],"ur":"نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا","ur2":"کام نہ آیا اُسکو مال اُسکا اور نہ جو اُس نے کمایا","en":"His wealth and gains will not exempt him"},{"w":[["سَيَصْلَىٰ","He will be burnt","sayaṣlā","",[["سَ",212,339,"p"],["يَصْلَىٰ",54,1453,""]],1453],["نَارًا","(in) a Fire","nāran","",[["نَارًا",94,104,""]],104],["ذَاتَ","of","dhāta","",[["ذَاتَ",327,455,""]],455],["لَهَبٍ","Blazing Flames","lahabin","",[["لَهَبٍ",42,4548,""]],4548]],"ur":"وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا","ur2":"ڈیگ مارتی آگ میں","en":"He will be plunged in flaming Fire"},{"w":[["وَٱمْرَأَتُهُۥ","And his wife","wa-im'ra-atuhu","",[["وَ",10,15,"p"],["ٱمْرَأَتُ",90,1113,""],["هُۥ",29,-1,"s"]],1113],["حَمَّالَةَ","(the) carrier","ḥammālata","",[["حَمَّالَةَ",1066,4773,""]],4773],["ٱلْحَطَبِ","(of) firewood","l-ḥaṭabi","",[["ٱلْ",3,3,"p"],["حَطَبِ",1,4462,""]],4462]],"ur":"اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے","ur2":"اور اُسکی جورو جو سر پر لئے پھرتی ہے ایندھن","en":"And his wife, the wood-carrier"},{"w":[["فِى","In","fī","",[["فِى",19,30,""]],30],["جِيدِهَا","her neck","jīdihā","",[["جِيدِ",1,4774,""],["هَا",125,-1,"s"]],4774],["حَبْلٌ","(will be) a rope","ḥablun","",[["حَبْلٌ",30,1278,""]],1278],["مِّن","of","min","",[["مِّن",19,37,""]],37],["مَّسَدٍۭ","palm-fiber","masadin","",[["مَّسَدٍۭ",42,4775,""]],4775]],"ur":"اس کے گلے میں مونج کی رسّی ہو گی","ur2":"اُسکی گردن میں رسی ہے مونجھ کی","en":"Will have upon her neck a halter of palm-fibre"}]}