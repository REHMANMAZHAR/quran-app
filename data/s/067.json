{"n":67,"ayahs":[{"w":[["تَبَٰرَكَ","Blessed is","tabāraka","",[["تَبَٰرَكَ",240,2086,""]],2086],["ٱلَّذِى","He","alladhī","",[["ٱلَّذِى",92,20,""]],20],["بِيَدِهِ","in Whose Hand","biyadihi","",[["بِ",0,0,"p"],["يَدِ",39,394,""],["هِ",29,-1,"s"]],394],["ٱلْمُلْكُ","(is) the Dominion","l-mul'ku","",[["ٱلْ",3,3,"p"],["مُلْكُ",5,524,""]],524],["وَهُوَ","and He","wahuwa","",[["وَ",10,15,"p"],["هُوَ",113,-1,""]],-1],["عَلَىٰ","(is) over","ʿalā","",[["عَلَىٰ",19,22,""]],22],["كُلِّ","every","kulli","",[["كُلِّ",1,138,""]],138],["شَىْءٍ","thing","shayin","",[["شَىْءٍ",42,139,""]],139],["قَدِيرٌ","All-Powerful","qadīrun","",[["قَدِيرٌ",30,140,""]],140]],"ur":"وہ (خدا) جس کے ہاتھ میں بادشاہی ہے بڑی برکت والا ہے۔ اور وہ ہر چیز پر قادر ہے","ur2":"بڑی برکت ہے اُسکی جسکے ہاتھ میں ہے راج اور وہ سب کچھ کر سکتا ہے","en":"Blessed is He in Whose hand is the Sovereignty, and, He is Able to do all things"},{"w":[["ٱلَّذِى","The One Who","alladhī","",[["ٱلَّذِى",92,20,""]],20],["خَلَقَ","created","khalaqa","",[["خَلَقَ",49,144,""]],144],["ٱلْمَوْتَ","death","l-mawta","",[["ٱلْ",3,3,"p"],["مَوْتَ",14,127,""]],127],["وَٱلْحَيَوٰةَ","and life","wal-ḥayata","",[["وَ",10,15,"p"],["ٱلْ",3,3,"p"],["حَيَوٰةَ",33,473,""]],473],["لِيَبْلُوَكُمْ","that He may test you","liyabluwakum","",[["لِ",253,7,"p"],["يَبْلُوَ",137,663,""],["كُمْ",71,-1,"s"]],663],["أَيُّكُمْ","which of you","ayyukum","",[["أَيُّ",499,142,""],["كُمْ",71,-1,"s"]],142],["أَحْسَنُ","(is) best","aḥsanu","",[["أَحْسَنُ",157,637,""]],637],["عَمَلًا","(in) deed","ʿamalan","",[["عَمَلًا",65,639,""]],639],["وَهُوَ","And He","wahuwa","",[["وَ",34,15,"p"],["هُوَ",113,-1,""]],-1],["ٱلْعَزِيزُ","(is) the All-Mighty","l-ʿazīzu","",[["ٱلْ",3,3,"p"],["عَزِيزُ",157,621,""]],621],["ٱلْغَفُورُ","the Oft-Forgiving","l-ghafūru","",[["ٱلْ",3,3,"p"],["غَفُورُ",158,718,""]],718]],"ur":"اسی نے موت اور زندگی کو پیدا کیا تاکہ تمہاری آزمائش کرے کہ تم میں کون اچھے عمل کرتا ہے۔ اور وہ زبردست (اور) بخشنے والا ہے","ur2":"جس نے بنایا مرنا اور جینا تاکہ تم کو جانچے کون تم میں اچھا کرتا ہے کام اور وہ زبردست ہے بخشنے والا","en":"Who hath created life and death that He may try you which of you is best in conduct; and He is the Mighty, the Forgiving"},{"w":[["ٱلَّذِى","The One Who","alladhī","",[["ٱلَّذِى",92,20,""]],20],["خَلَقَ","created","khalaqa","",[["خَلَقَ",49,144,""]],144],["سَبْعَ","seven","sabʿa","",[["سَبْعَ",14,209,""]],209],["سَمَٰوَٰتٍ","heavens","samāwātin","",[["سَمَٰوَٰتٍ",97,119,""]],119],["طِبَاقًا","one above another","ṭibāqan","",[["طِبَاقًا",719,4367,""]],4367],["مَّا","Not","mā","",[["مَّا",22,64,""]],64],["تَرَىٰ","you see","tarā","",[["تَرَىٰ",151,324,""]],324],["فِى","in","fī","",[["فِى",19,30,""]],30],["خَلْقِ","(the) creation","khalqi","",[["خَلْقِ",1,682,""]],682],["ٱلرَّحْمَٰنِ","(of) the Most Gracious","l-raḥmāni","",[["ٱل",3,3,"p"],["رَّحْمَٰنِ",263,4,""]],4],["مِن","any","min","",[["مِن",19,37,""]],37],["تَفَٰوُتٍ","fault","tafāwutin","",[["تَفَٰوُتٍ",428,4368,""]],4368],["فَٱرْجِعِ","So return","fa-ir'jiʿi","",[["فَ",173,72,"p"],["ٱرْجِعِ",12,116,""]],116],["ٱلْبَصَرَ","the vision","l-baṣara","",[["ٱلْ",3,3,"p"],["بَصَرَ",14,57,""]],57],["هَلْ","can","hal","",[["هَلْ",387,847,""]],847],["تَرَىٰ","you see","tarā","",[["تَرَىٰ",151,324,""]],324],["مِن","any","min","",[["مِن",19,37,""]],37],["فُطُورٍ","flaw","fuṭūrin","",[["فُطُورٍ",42,4369,""]],4369]],"ur":"اس نے سات آسمان اوپر تلے بنائے۔ (اے دیکھنے والے) کیا تو (خدا) رحمٰن کی آفرینش میں کچھ نقص دیکھتا ہے؟ ذرا آنکھ اٹھا کر دیکھ بھلا تجھ کو (آسمان میں) کوئی شگاف نظر آتا ہے؟","ur2":"جس نے بنائے سات آسمان تہہ پر تہہ کیا دیکھتا ہے تو رحمٰن کے بنانے میں کچھ فرق پھر دوبارہ نگاہ کر کہیں نظر آتی ہے تجھ کو دڑاڑ","en":"Who hath created seven heavens in harmony. Thou (Muhammad) canst see no fault in the Beneficent One's creation; then look again: Canst thou see any rifts"},{"w":[["ثُمَّ","Then","thumma","",[["ثُمَّ",47,204,""]],204],["ٱرْجِعِ","return","ir'jiʿi","",[["ٱرْجِعِ",12,116,""]],116],["ٱلْبَصَرَ","the vision","l-baṣara","",[["ٱلْ",3,3,"p"],["بَصَرَ",14,57,""]],57],["كَرَّتَيْنِ","twice (again)","karratayni","",[["كَرَّتَيْنِ",609,699,""]],699],["يَنقَلِبْ","Will return","yanqalib","",[["يَنقَلِبْ",537,645,""]],645],["إِلَيْكَ","to you","ilayka","",[["إِلَيْ",19,42,""],["كَ",18,-1,"s"]],42],["ٱلْبَصَرُ","the vision","l-baṣaru","",[["ٱلْ",3,3,"p"],["بَصَرُ",5,57,""]],57],["خَاسِئًا","humbled","khāsi-an","",[["خَاسِئًا",227,391,""]],391],["وَهُوَ","while it","wahuwa","",[["وَ",56,15,"p"],["هُوَ",113,-1,""]],-1],["حَسِيرٌ","(is) fatigued","ḥasīrun","",[["حَسِيرٌ",148,4370,""]],4370]],"ur":"پھر دو بارہ (سہ بارہ) نظر کر، تو نظر (ہر بار) تیرے پاس ناکام اور تھک کر لوٹ آئے گی","ur2":"پھر لوٹا کر نگاہ کر دو دو بار لوٹ آئے گی تیرے پاس تیری نگاہ رد ہو کر تھک کر","en":"Then look again and yet again, thy sight will return unto thee weakened and made dim"},{"w":[["وَلَقَدْ","And certainly","walaqad","",[["وَ",34,15,"p"],["لَ",106,7,"p"],["قَدْ",217,352,""]],352],["زَيَّنَّا","We have beautified","zayyannā","",[["زَيَّ",118,850,""],["نَّا",13,-1,"s"]],850],["ٱلسَّمَآءَ","the heaven","l-samāa","",[["ٱل",3,3,"p"],["سَّمَآءَ",33,119,""]],119],["ٱلدُّنْيَا","nearest","l-dun'yā","",[["ٱل",3,3,"p"],["دُّنْيَا",272,474,""]],474],["بِمَصَٰبِيحَ","with lamps","bimaṣābīḥa","",[["بِ",0,0,"p"],["مَصَٰبِيحَ",6,3462,""]],3462],["وَجَعَلْنَٰهَا","and We have made them","wajaʿalnāhā","",[["وَ",10,15,"p"],["جَعَلْ",36,122,""],["نَٰ",13,-1,"s"],["هَا",125,-1,"s"]],122],["رُجُومًا","(as) missiles","rujūman","",[["رُجُومًا",65,4371,""]],4371],["لِّلشَّيَٰطِينِ","for the devils","lilshayāṭīni","",[["لِّ",0,7,"p"],["ل",3,3,"p"],["شَّيَٰطِينِ",845,90,""]],90],["وَأَعْتَدْنَا","and We have prepared","wa-aʿtadnā","",[["وَ",10,15,"p"],["أَعْتَدْ",55,1473,""],["نَا",13,-1,"s"]],1473],["لَهُمْ","for them","lahum","",[["لَ",0,7,"p"],["هُمْ",40,-1,""]],-1],["عَذَابَ","punishment","ʿadhāba","",[["عَذَابَ",14,59,""]],59],["ٱلسَّعِيرِ","(of) the Blaze","l-saʿīri","",[["ٱل",3,3,"p"],["سَّعِيرِ",1,1454,""]],1454]],"ur":"اور ہم نے قریب کے آسمان کو (تاروں کے) چراغوں سے زینت دی۔ اور ان کو شیطان کے مارنے کا آلہ بنایا اور ان کے لئے دہکتی آگ کا عذاب تیار کر رکھا ہے","ur2":"اور ہم نے رونق دی سب سے ورلے آسمان کو چراغوں سے اور اُن سے کر رکھی ہے ہم نے پھینک مار شیطانوں کے واسطے اور رکھا ہے اُنکے واسطے عذاب دہکتی آگ کا","en":"And verily We have beautified the world's heaven with lamps, and We have made them missiles for the devils, and for them We have prepared the doom of flame"},{"w":[["وَلِلَّذِينَ","And for those who","walilladhīna","",[["وَ",34,15,"p"],["لِ",0,7,"p"],["لَّذِينَ",16,20,""]],20],["كَفَرُوا۟","disbelieved","kafarū","",[["كَفَرُ",45,48,""],["وا۟",20,-1,"s"]],48],["بِرَبِّهِمْ","in their Lord","birabbihim","",[["بِ",0,0,"p"],["رَبِّ",1,8,""],["هِمْ",20,-1,"s"]],8],["عَذَابُ","(is the) punishment","ʿadhābu","",[["عَذَابُ",5,59,""]],59],["جَهَنَّمَ","(of) Hell","jahannama","",[["جَهَنَّمَ",2,840,""]],840],["وَبِئْسَ","and wretched is","wabi'sa","",[["وَ",34,15,"p"],["بِئْسَ",49,494,""]],494],["ٱلْمَصِيرُ","the destination","l-maṣīru","",[["ٱلْ",3,3,"p"],["مَصِيرُ",323,611,""]],611]],"ur":"اور جن لوگوں نے اپنے پروردگار سے انکار کیا ان کے لئے جہنم کا عذاب ہے۔ اور وہ برا ٹھکانہ ہے","ur2":"اور جو لوگ منکر ہوئے اپنے رب سے اُنکے واسطے ہے عذاب دردناک اور بری جگہ جا پہنچے","en":"And for those who disbelieve in their Lord there is the doom of hell, a hapless journey's end"},{"w":[["إِذَآ","When","idhā","",[["إِذَآ",67,77,""]],77],["أُلْقُوا۟","they are thrown","ul'qū","",[["أُلْقُ",282,789,""],["وا۟",20,-1,"s"]],789],["فِيهَا","therein","fīhā","",[["فِي",19,30,""],["هَا",125,-1,"s"]],30],["سَمِعُوا۟","they will hear","samiʿū","",[["سَمِعُ",45,434,""],["وا۟",20,-1,"s"]],434],["لَهَا","from it","lahā","",[["لَ",0,7,"p"],["هَا",235,-1,""]],-1],["شَهِيقًا","an inhaling","shahīqan","",[["شَهِيقًا",65,2588,""]],2588],["وَهِىَ","while it","wahiya","",[["وَ",56,15,"p"],["هِىَ",235,-1,""]],-1],["تَفُورُ","boils up","tafūru","",[["تَفُورُ",130,2515,""]],2515]],"ur":"جب وہ اس میں ڈالے جائیں گے تو اس کا چیخنا چلانا سنیں گے اور وہ جوش مار رہی ہوگی","ur2":"جب اُس میں ڈالے جائیں گے سنیں گے اُس کا دہاڑنا اور وہ اچھل رہی ہو گی","en":"When they are flung therein they hear its roaring as it boileth up"},{"w":[["تَكَادُ","It almost","takādu","",[["تَكَادُ",877,130,""]],130],["تَمَيَّزُ","bursts","tamayyazu","",[["تَمَيَّزُ",795,4372,""]],4372],["مِنَ","from","mina","",[["مِنَ",19,37,""]],37],["ٱلْغَيْظِ","rage","l-ghayẓi","",[["ٱلْ",3,3,"p"],["غَيْظِ",1,1305,""]],1305],["كُلَّمَآ","Every time","kullamā","",[["كُلَّمَآ",67,132,""]],132],["أُلْقِىَ","is thrown","ul'qiya","",[["أُلْقِىَ",37,789,""]],789],["فِيهَا","therein","fīhā","",[["فِي",19,30,""],["هَا",125,-1,"s"]],30],["فَوْجٌ","a group","fawjun","",[["فَوْجٌ",30,3624,""]],3624],["سَأَلَهُمْ","(will) ask them","sa-alahum","",[["سَأَلَ",49,369,""],["هُمْ",20,-1,"s"]],369],["خَزَنَتُهَآ","its keepers","khazanatuhā","",[["خَزَنَتُ",81,3955,""],["هَآ",125,-1,"s"]],3955],["أَلَمْ","Did not","alam","",[["أَ",82,85,"p"],["لَمْ",22,53,""]],53],["يَأْتِكُمْ","come to you","yatikum","",[["يَأْتِ",315,157,""],["كُمْ",71,-1,"s"]],157],["نَذِيرٌ","a warner","nadhīrun","",[["نَذِيرٌ",30,584,""]],584]],"ur":"گویا مارے جوش کے پھٹ پڑے گی۔ جب اس میں ان کی کوئی جماعت ڈالی جائے گی تو دوزخ کے داروغہ ان سے پوچھیں گے کہ تمہارے پاس کوئی ہدایت کرنے والا نہیں آیا تھا؟","ur2":"ایسا لگتا ہے کہ پھٹ پڑے گی جوش سے جس وقت پڑے اُس میں ایک گروہ پوچھیں اُن سے دوزخ کے داروغہ کیا نہ پہنچا تھا تمہارے پاس کوئی ڈر سنانے والا","en":"As it would burst with rage. Whenever a (fresh) host is flung therein the wardens thereof ask them: Came there unto you no warner"},{"w":[["قَالُوا۟","They will say","qālū","",[["قَالُ",45,63,""],["وا۟",20,-1,"s"]],63],["بَلَىٰ","Yes","balā","",[["بَلَىٰ",259,450,""]],450],["قَدْ","indeed","qad","",[["قَدْ",217,352,""]],352],["جَآءَنَا","came to us","jāanā","",[["جَآءَ",49,420,""],["نَا",13,-1,"s"]],420],["نَذِيرٌ","a warner","nadhīrun","",[["نَذِيرٌ",30,584,""]],584],["فَكَذَّبْنَا","but we denied","fakadhabnā","",[["فَ",10,72,"p"],["كَذَّبْ",118